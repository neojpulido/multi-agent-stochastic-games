Cell[BoxData[
 RowBox[{
  RowBox[{"oneRound", "[", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "allGames", ",", " ", "traitsInGameOrder", ",", " ", 
      "payoffsInGameOrder"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"allGames", "=", 
      RowBox[{"Partition", "[", 
       RowBox[{
        RowBox[{"RandomSample", "[", 
         RowBox[{"Range", "[", "populationSize", "]"}], "]"}], ",", 
        "gameSize"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"traitsInGameOrder", "=", 
      RowBox[{"population", "[", 
       RowBox[{"[", 
        RowBox[{"allGames", "//", "Flatten"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"payoffsInGameOrder", "=", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{"payoffSingleGame", ",", "allGames"}], "]"}], "//", 
       "Flatten"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"population", "=", 
      RowBox[{"RandomChoice", "[", 
       RowBox[{
        RowBox[{"payoffsInGameOrder", "->", "traitsInGameOrder"}], ",", 
        "populationSize"}], "]"}]}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.86933826557192*^9, 3.869338271642646*^9}, {
