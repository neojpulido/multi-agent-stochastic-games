Cell[TextData[StyleBox["Play with gamesizes 10,20. What do you observe for \
the payoff at both carparks in steady-state. Does this agree with your \
expectations? Explain the reasons for your reasoning.",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.86934693826241*^9, 3.869346984139327*^9}, {
  3.869347460705923*^9, 3.869347554250602*^9}, {3.869348541826498*^9, 
  3.869348548124309*^9}},ExpressionUUID->"5d2e1e6e-437d-47c6-91fd-\
7df9feea5813"],

Cell["\<\
The fractions do not actually steady into a steady state but fluctuate around \
it instead. You need large population sizes (n>1,000) and should use \
sufficiently long simulation horizons (t=1,000) to see easily interpretable \
reasonable results.\
\>", "Text",
 CellChangeTimes->{{3.8693479379187937`*^9, 3.869347964817244*^9}, {
  3.869348058726982*^9, 3.869348100542801*^9}, {3.869348553162722*^9, 
  3.869348557844728*^9}, {3.936228054957478*^9, 3.936228074555599*^9}, {
  3.9362281573069477`*^9, 
  3.936228157729672*^9}},ExpressionUUID->"1fa34d25-a6b9-4b36-9313-\
faab62615171"],

Cell["\<\
Payoff should be equal for both carparks. The exact steady-state solution for \
our current games size (10) is:\
\>", "Text",
 CellChangeTimes->{{3.869347557517029*^9, 3.86934763134682*^9}, {
  3.869347837062065*^9, 3.869347855033759*^9}, {3.936227790924719*^9, 
  3.9362277979915457`*^9}, {3.936228167580583*^9, 
  3.9362281692833643`*^9}},ExpressionUUID->"a193e1c1-357b-4b27-8e2d-\
fe5d23f6de80"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"x", "+", "y"}], "==", "gameSize"}], "&&", 
     RowBox[{"(", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"d1", "+", 
         RowBox[{"\[Alpha]", " ", "x"}]}]], "==", " ", 
       FractionBox["1", 
        RowBox[{"d2", " ", "+", " ", 
         RowBox[{"\[Beta]", " ", "y"}]}]]}], ")"}]}], "/.", " ", 
    "parameters"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.869347716474845*^9, 3.869347786741871*^9}, 
   3.869347817346261*^9, {3.869348123704763*^9, 3.869348126177619*^9}, 
   3.8693483551267347`*^9},
 CellLabel->"In[51]:=",ExpressionUUID->"e8789144-63b9-46f9-9341-6e8256e7ca9e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "\[Rule]", 
     FractionBox["16", "3"]}], ",", 
    RowBox[{"y", "\[Rule]", 
     FractionBox["14", "3"]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{
  3.8693477275106697`*^9, {3.869347757594335*^9, 3.869347787378298*^9}, 
   3.869347817988381*^9, 3.9362277510802402`*^9, 3.936228119934004*^9},
 CellLabel->"Out[51]=",ExpressionUUID->"8856bffd-a8b9-487d-a947-bf654baa81e1"]
}, Open  ]],

