Cell[BoxData[
 RowBox[{
  RowBox[{"play", "[", 
   RowBox[{"tEnd_", ",", " ", "plotInterval_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"population", " ", "=", " ", 
      RowBox[{"RandomChoice", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0.01", ",", "0.99"}], "}"}], "->", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}]}], ",", " ", "populationSize"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"t", "=", "1"}], ",", 
       RowBox[{"t", "\[LessEqual]", "tEnd"}], ",", 
       RowBox[{"t", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"t", ",", "plotInterval"}], "]"}], "\[Equal]", "0"}], ",", 
          RowBox[{"Sow", "[", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"t", ",", 
              RowBox[{"Count", "[", 
               RowBox[{"population", ",", "1"}], "]"}]}], "}"}], "}"}], 
           "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"oneRound", "[", "]"}]}]}], "\[IndentingNewLine]", "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
