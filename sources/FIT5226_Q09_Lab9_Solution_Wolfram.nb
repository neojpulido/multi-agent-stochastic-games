Cell[BoxData[
 RowBox[{
  RowBox[{"payoffSingleGame", "[", "indexList_", "]"}], ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"traitValues", "=", 
       RowBox[{"population", "[", 
        RowBox[{"[", "indexList", "]"}], "]"}]}], ",", " ", "visitorsA", ",", 
      " ", "visitorsB"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"visitorsA", ",", "visitorsB"}], "}"}], "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Count", "[", 
         RowBox[{"traitValues", ",", "i"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "2"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"payoffs", "=", 
      RowBox[{"payoff", "[", 
       RowBox[{"visitorsA", ",", " ", "visitorsB"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"payoffs", "[", 
         RowBox[{"[", "#", "]"}], "]"}], "&"}], ",", "traitValues"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.685950661191288*^9, 3.685950759694633*^9}, {
   3.869333564753227*^9, 3.869333570981443*^9}, {3.8693336451425667`*^9, 
